# Copy to .env locally. Never commit real values.

RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

AUTO_UPLOAD=true
# Must stay false. Any other value is a configuration error: public publishing
# requires manifest approval plus `publish --confirm-public`, never an env var.
AUTO_PUBLISH=false

# Optional provider/model overrides
IMAGE_PROVIDER=
VIDEO_PROVIDER=runway
VOICE_PROVIDER=elevenlabs
