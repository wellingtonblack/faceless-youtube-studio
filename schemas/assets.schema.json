{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Episode asset registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "pattern": "^file-[0-9]{3}$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "kind",
          "scene_id",
          "shot_id",
          "take",
          "path",
          "sha256",
          "dependencies",
          "provider",
          "model",
          "prompt_version",
          "job_id",
          "generated_at",
          "settings",
          "source",
          "license",
          "selected",
          "review_ref"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "keyframe",
              "clip",
              "graphic",
              "voice",
              "music",
              "sfx",
              "caption",
              "master",
              "qc_report"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "scene_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^scene-[0-9]{2}$"
          },
          "shot_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^scene-[0-9]{2}-shot-[0-9]{2}$"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "job_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "generated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "take": {
            "type": "integer",
            "minimum": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "settings": {
            "type": "object"
          },
          "selected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
