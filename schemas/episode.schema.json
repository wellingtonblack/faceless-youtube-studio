{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theimpossiblefiles.local/schemas/episode.schema.json",
  "title": "The Impossible Files Episode Manifest",
  "description": "Schema version 2. See docs/migrations/2026-10-03-episode-manifest-v2.md for changes from v1 and for validator rules that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "file_number",
    "title",
    "format",
    "language",
    "aspect_ratio",
    "status",
    "characters",
    "approvals",
    "publishing"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "episode_id": {
      "type": "string",
      "pattern": "^file-[0-9]{3}$"
    },
    "file_number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "enum": [
        "short",
        "long"
      ]
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ]
    },
    "target_duration_seconds": {
      "type": "number",
      "minimum": 1
    },
    "status": {
      "description": "The latest lifecycle stage the episode has entered. Work in that stage may still be in progress. Status never authorizes anything by itself; approvals do.",
      "enum": [
        "idea",
        "approved",
        "script",
        "storyboard",
        "assets",
        "voice",
        "clips",
        "edit",
        "qc",
        "upload_private",
        "approved_for_publish",
        "published",
        "measured"
      ]
    },
    "series": {
      "type": "string"
    },
    "lore_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "script_path": {
      "type": "string"
    },
    "storyboard_path": {
      "description": "Canonical storyboard. Scenes are declared as '## scene-NN' headings; scene count is derived from it, never stored in the manifest.",
      "type": "string"
    },
    "characters": {
      "description": "IDs of recurring characters (folder names under characters/) who appear in any form: visual, voice, narration or text. Empty array means no recurring character appears.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "voice_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "approvals": {
      "description": "Human approval gates. The single source of truth for every authorization, including public publishing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_script",
        "recurring_characters",
        "lore_additions",
        "final_qc",
        "public_publish"
      ],
      "properties": {
        "final_script": {
          "$ref": "#/$defs/approval"
        },
        "recurring_characters": {
          "description": "One entry per recurring character appearing in this episode for the first time or in a new version.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "character_id",
              "approved",
              "approved_by",
              "approved_at",
              "ref"
            ],
            "properties": {
              "character_id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "approved": {
                "$ref": "#/$defs/approved"
              },
              "approved_by": {
                "$ref": "#/$defs/approvedBy"
              },
              "approved_at": {
                "$ref": "#/$defs/approvedAt"
              },
              "ref": {
                "$ref": "#/$defs/approvalRef"
              }
            },
            "allOf": [
              {
                "$ref": "#/$defs/approvedRequiresRecord"
              }
            ]
          }
        },
        "lore_additions": {
          "description": "One entry per substantial lore addition introduced by this episode.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "summary",
              "approved",
              "approved_by",
              "approved_at",
              "ref"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "approved": {
                "$ref": "#/$defs/approved"
              },
              "approved_by": {
                "$ref": "#/$defs/approvedBy"
              },
              "approved_at": {
                "$ref": "#/$defs/approvedAt"
              },
              "ref": {
                "$ref": "#/$defs/approvalRef"
              }
            },
            "allOf": [
              {
                "$ref": "#/$defs/approvedRequiresRecord"
              }
            ]
          }
        },
        "final_qc": {
          "$ref": "#/$defs/approval"
        },
        "public_publish": {
          "$ref": "#/$defs/approval"
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "youtube_privacy",
        "selfDeclaredMadeForKids",
        "containsSyntheticMedia"
      ],
      "properties": {
        "youtube_privacy": {
          "enum": [
            "private",
            "unlisted",
            "public"
          ]
        },
        "selfDeclaredMadeForKids": {
          "description": "Mirrors YouTube Data API videos.status.selfDeclaredMadeForKids.",
          "type": "boolean"
        },
        "containsSyntheticMedia": {
          "description": "Mirrors YouTube Data API videos.status.containsSyntheticMedia (altered or synthetic content disclosure).",
          "type": "boolean"
        },
        "youtube_video_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Production past scripting requires an approved final script.",
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "storyboard",
              "assets",
              "voice",
              "clips",
              "edit",
              "qc",
              "upload_private",
              "approved_for_publish",
              "published",
              "measured"
            ]
          }
        }
      },
      "then": {
        "$ref": "#/$defs/requireApproved/final_script"
      }
    },
    {
      "description": "Publish-stage statuses require both final QC and public publish approval.",
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "approved_for_publish",
              "published",
              "measured"
            ]
          }
        }
      },
      "then": {
        "allOf": [
          {
            "$ref": "#/$defs/requireApproved/final_qc"
          },
          {
            "$ref": "#/$defs/requireApproved/public_publish"
          }
        ]
      }
    },
    {
      "description": "Any non-private visibility requires public publish approval.",
      "if": {
        "required": [
          "publishing"
        ],
        "properties": {
          "publishing": {
            "required": [
              "youtube_privacy"
            ],
            "properties": {
              "youtube_privacy": {
                "enum": [
                  "unlisted",
                  "public"
                ]
              }
            }
          }
        }
      },
      "then": {
        "$ref": "#/$defs/requireApproved/public_publish"
      }
    },
    {
      "description": "Published episodes must be public and record the YouTube video ID and publication time.",
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "published",
              "measured"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "publishing": {
            "required": [
              "youtube_privacy",
              "youtube_video_id",
              "published_at"
            ],
            "properties": {
              "youtube_privacy": {
                "const": "public"
              },
              "youtube_video_id": {
                "type": "string",
                "minLength": 1
              },
              "published_at": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "approved": {
      "type": "boolean"
    },
    "approvedBy": {
      "description": "Human approver (GitHub handle). Agents never self-approve.",
      "type": [
        "string",
        "null"
      ]
    },
    "approvedAt": {
      "description": "ISO 8601 date or date-time of the approval.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T.+)?$"
    },
    "approvalRef": {
      "description": "Repository path (optionally with #anchor) or issue/PR URL documenting the decision.",
      "type": [
        "string",
        "null"
      ]
    },
    "approvedRequiresRecord": {
      "description": "An approval marked true must say who approved it, when, and where the decision is documented.",
      "if": {
        "required": [
          "approved"
        ],
        "properties": {
          "approved": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "approved_by",
        "approved_at",
        "ref"
      ],
      "properties": {
        "approved": {
          "$ref": "#/$defs/approved"
        },
        "approved_by": {
          "$ref": "#/$defs/approvedBy"
        },
        "approved_at": {
          "$ref": "#/$defs/approvedAt"
        },
        "ref": {
          "$ref": "#/$defs/approvalRef"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/approvedRequiresRecord"
        }
      ]
    },
    "requireApproved": {
      "final_script": {
        "required": [
          "approvals"
        ],
        "properties": {
          "approvals": {
            "properties": {
              "final_script": {
                "properties": {
                  "approved": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "final_qc": {
        "required": [
          "approvals"
        ],
        "properties": {
          "approvals": {
            "properties": {
              "final_qc": {
                "properties": {
                  "approved": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "public_publish": {
        "required": [
          "approvals"
        ],
        "properties": {
          "approvals": {
            "properties": {
              "public_publish": {
                "properties": {
                  "approved": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
